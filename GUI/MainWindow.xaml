<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUI" Height="650" Width="900"
        MinHeight="450" MinWidth="700"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{x:Static ApplicationCommands.Cut}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{x:Static ApplicationCommands.Copy}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static ApplicationCommands.Paste}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{x:Static ApplicationCommands.SelectAll}" />
        <KeyBinding Key="Delete" Command="{x:Static ApplicationCommands.Delete}" />
    </Window.InputBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Создать" Click="FileNew_Click"/>
                <MenuItem Header="Открыть..." Click="FileOpen_Click"/>
                <Separator/>
                <MenuItem Header="Сохранить" Click="FileSave_Click"/>
                <MenuItem Header="Сохранить как..." Click="FileSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="FileExit_Click"/>
            </MenuItem>

            <MenuItem Header="_Правка">
                <MenuItem Header="Отменить" Click="EditUndo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Повторить" Click="EditRedo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Вырезать" Click="EditCut_Click" InputGestureText="Ctrl+X"/>
                <MenuItem Header="Копировать" Click="EditCopy_Click" InputGestureText="Ctrl+C"/>
                <MenuItem Header="Вставить" Click="EditPaste_Click" InputGestureText="Ctrl+V"/>
                <MenuItem Header="Удалить" Click="EditDelete_Click" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="Выделить всё" Click="EditSelectAll_Click" InputGestureText="Ctrl+A"/>
            </MenuItem>

            <MenuItem Header="_Текст">
                <MenuItem Header="Постановка задачи" Click="TextTask_Click"/>
                <MenuItem Header="Грамматика" Click="TextGrammar_Click"/>
                <MenuItem Header="Классификация грамматики" Click="TextGrammarClass_Click"/>
                <MenuItem Header="Метод анализа" Click="TextAnalyzeMethod_Click"/>
                <MenuItem Header="Тестовый пример" Click="TextTest_Click"/>
                <MenuItem Header="Список литературы" Click="TextRefs_Click"/>
                <MenuItem Header="Исходный код программы" Click="TextSource_Click"/>
            </MenuItem>

            <MenuItem Header="_Пуск" Click="Run_Click"/>

            <MenuItem Header="_Справка">
                <MenuItem Header="Вызов справки" Click="Help_Click"/>
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolBtn}" ToolTip="Создать" Click="FileNew_Click">
                    <Image Source="Assets/new.png"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Открыть" Click="FileOpen_Click">
                    <Image Source="Assets/open.png"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Сохранить" Click="FileSave_Click">
                    <Image Source="Assets/save.png"/>
                </Button>

                <Separator/>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Отменить" Click="EditUndo_Click">
                    <Image Source="Assets/undo.png"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Повторить" Click="EditRedo_Click">
                    <Image Source="Assets/redo.png"/>
                </Button>

                <Separator/>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Копировать" Click="EditCopy_Click">
                    <Image Source="Assets/copy.png"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Вырезать" Click="EditCut_Click">
                    <Image Source="Assets/cut.png"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Вставить" Click="EditPaste_Click">
                    <Image Source="Assets/paste.png"/>
                </Button>

                <Separator/>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Пуск" Click="Run_Click">
                    <Image Source="Assets/run.png" Width="27"/>
                </Button>

                <Separator/>

                <Button Style="{StaticResource ToolBtn}" ToolTip="Справка" Click="Help_Click">
                    <Image Source="Assets/help.png" Height="27" Width="29"/>
                </Button>

                <Button Style="{StaticResource ToolBtn}" ToolTip="О программе" Click="About_Click">
                    <Image Source="Assets/info.png"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="EditorTextBox"
                     Grid.Row="0"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Margin="6"
                     TextChanged="EditorTextBox_TextChanged"
                     PreviewKeyDown="EditorTextBox_PreviewKeyDown">

                <TextBox.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Undo" Executed="EditUndo_Click"/>
                    <CommandBinding Command="ApplicationCommands.Redo" Executed="EditRedo_Click"/>
                    <CommandBinding Command="ApplicationCommands.Cut" Executed="EditCut_Click"/>
                    <CommandBinding Command="ApplicationCommands.Copy" Executed="EditCopy_Click"/>
                    <CommandBinding Command="ApplicationCommands.Paste" Executed="EditPaste_Click"/>
                    <CommandBinding Command="ApplicationCommands.Delete" Executed="EditDelete_Click"/>
                    <CommandBinding Command="ApplicationCommands.SelectAll" Executed="EditSelectAll_Click"/>
                </TextBox.CommandBindings>
            </TextBox>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          Background="#DDD"
                          ShowsPreview="True"/>

            <DockPanel Grid.Row="2" Margin="6">
                <Border DockPanel.Dock="Top"
                        Padding="8,4"
                        Background="#F5F5F5"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,6">
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="Gray"
                               Text=""/>
                </Border>

                <DataGrid x:Name="LexemesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#FAFAFA"
                          BorderBrush="#DDDDDD"
                          BorderThickness="1"
                          MouseLeftButtonUp="LexemesGrid_MouseLeftButtonUp"
                          SelectionChanged="LexemesGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код"
                                            Binding="{Binding Code}"
                                            Width="Auto"
                                            MinWidth="60"/>

                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}"
                                            Width="2*"
                                            MinWidth="170"/>

                        <DataGridTextColumn Header="Лексема"
                                            Binding="{Binding Text}"
                                            Width="*"
                                            MinWidth="120"/>

                        <DataGridTextColumn Header="Позиция"
                                            Binding="{Binding Location}"
                                            Width="Auto"
                                            MinWidth="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>